{
  "name": "block-bim-studio",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run build -w @block-bim-studio/shared && npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:mock": "MOCK_AWS=true npm run dev:mock -w @block-bim-studio/backend",
    "dev:web": "npm run dev -w @block-bim-studio/frontend"
  }
}
